#!/bin/sh
# ステージ済み差分を gitleaks で検査し、秘密情報があれば commit を止める。
# 有効化: git config core.hooksPath .githooks
set -eu

# フックはログインシェルの PATH を継承しないことがある。
# M1 Mac の Homebrew と mise の shim を補う。
if [ -d /opt/homebrew/bin ]; then
  PATH="/opt/homebrew/bin:${PATH}"
fi
if [ -d /usr/local/bin ]; then
  PATH="/usr/local/bin:${PATH}"
fi
if [ -n "${HOME:-}" ] && [ -d "${HOME}/.local/share/mise/shims" ]; then
  PATH="${HOME}/.local/share/mise/shims:${PATH}"
fi
export PATH

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks が PATH にありません。commit を中止しました。" >&2
  echo "macOS の例: brew install gitleaks" >&2
  echo "または: mise use -g gitleaks@8.30.1" >&2
  exit 1
fi

exec gitleaks git --pre-commit --redact --staged --verbose --no-banner
